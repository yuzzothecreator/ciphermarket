# =============================================================================
# CipherMarket — Environment Configuration (copy to .env for local development)
# Never commit .env with real secrets.
# =============================================================================

# --- Application ---
COMPOSE_PROJECT_NAME=ciphermarket
NODE_ENV=development

# --- Web (Next.js) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=ciphermarket
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=ciphermarket-web

# --- API (Spring Boot) ---
API_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ciphermarket
POSTGRES_USER=ciphermarket
POSTGRES_PASSWORD=change_me_in_local_env

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_local_env

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ciphermarket
RABBITMQ_PASSWORD=change_me_in_local_env
RABBITMQ_VHOST=ciphermarket

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=ciphermarket
MINIO_ROOT_PASSWORD=change_me_in_local_env
MINIO_BUCKET_QUARANTINE=ciphermarket-quarantine
MINIO_BUCKET_PROTECTED=ciphermarket-protected

# --- HashiCorp Vault (dev mode — NOT for production) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token
VAULT_TRANSIT_KEY=ciphermarket-dek

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=ciphermarket
KEYCLOAK_CLIENT_ID=ciphermarket-api
KEYCLOAK_CLIENT_SECRET=change_me_in_local_env
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_local_env

# --- Mailpit ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- ClamAV ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ciphermarket-api
